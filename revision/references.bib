@online{holyDisaggregatingInputOutputTables2022,
  title = {Disaggregating {{Input--Output Tables}} by the {{Multidimensional RAS
           Method}}: {{A Case Study}} of the {{Czech Republic}}},
  shorttitle = {Disaggregating {{Input--Output Tables}} by the {{
                Multidimensional RAS Method}}},
  author = {Holý, Vladimír and Šafr, Karel},
  date = {2022-07-27},
  eprint = {1704.07814},
  eprinttype = {arXiv},
  eprintclass = {stat},
  url = {http://arxiv.org/abs/1704.07814},
  urldate = {2024-03-12},
  abstract = {An unknown input-output table can be estimated by the RAS method
              when only its row and column sums are known and some initial
              structure is assumed. The RAS approach can also be utilized for
              disaggregation of an annual national table to more detailed tables
              such as regional, quarterly and domestic/imported tables. However,
              the regular RAS method does not ensure that the sums of
              disaggregated tables are equal to the total table. For this problem
              , we propose to use the multidimensional RAS method which besides
              input and output totals also ensures regional, quarterly and
              domestic/imported totals. Our analysis of the Czech industry shows
              that the multidimensional RAS method increases the accuracy of
              table estimation as well as accuracy of input-output applications
              such as the Leontief inverse, the regional Isard’s model and the
              quarterly value added.},
  langid = {english},
  pubstate = {prepublished},
  keywords = {Statistics - Applications},
  file = {/home/franzs/Zotero/storage/Z9G4M4AE/Holý und Šafr - 2022 -
          Disaggregating Input--Output Tables by the Multidi.pdf},
}

